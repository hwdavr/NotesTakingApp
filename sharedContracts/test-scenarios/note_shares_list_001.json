{
  "id": "note_shares_list_001",
  "description": "Lists collaborators and pending invites for a note. Owner is added locally by the client and is not returned by the API.",
  "apiMocks": [
    {
      "method": "GET",
      "path": "/v1/notes/note_001/shares",
      "status": 200,
      "response": [
        {
          "id": "share_001",
          "noteId": "note_001",
          "userId": "auth0|hannah",
          "email": "hannah.lee@example.com",
          "displayName": "Hannah Lee",
          "accessRole": "full_access",
          "status": "active",
          "invitedByUserId": "auth0|owner",
          "createdAt": "2026-05-09T10:00:00Z",
          "updatedAt": "2026-05-09T10:00:00Z"
        },
        {
          "id": "share_002",
          "noteId": "note_001",
          "userId": null,
          "email": "new.user@example.com",
          "displayName": null,
